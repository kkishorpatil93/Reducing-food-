# ==============================================================================
# FoodSave AI — Git Ignore Rules
# Protects secrets, credentials, databases, and dependencies from being committed.
# ==============================================================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Database binary files & WAL logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
server/*.db
server/*.db-shm
server/*.db-wal

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
build/
*.local

# Uploaded images & media
uploads/
server/uploads/

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
