# ==============================================================================
# FoodSave AI — Environment Configuration Template (.env.example)
#
# IMPORTANT:
# 1. Copy this file and rename it to ".env":
#      cp .env.example .env   (or copy-paste on Windows)
# 2. Never commit the actual ".env" file to GitHub or share secret keys.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (where your teammate's React frontend runs)
FRONTEND_ORIGIN=http://localhost:5173

# Authentication Security (Replace with a strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
DATABASE_PATH=./server/foodbridge.db

# File Upload / Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
